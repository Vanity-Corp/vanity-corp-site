# Base URL of vanity-backend (NestJS). No NEXT_PUBLIC_ prefix needed: the
# CMS read client and the form proxy are both server-only.
API_URL=http://localhost:3000

# Must match the "formSubmissionToken" set in Dashboard → Paramètres →
# Intégrations (or the backend's FORM_SUBMISSION_TOKEN env fallback).
FORM_SUBMISSION_TOKEN=

# Must match the "revalidateSecret" set in Dashboard → Paramètres →
# Intégrations. Used to authenticate the backend's ping to /api/revalidate.
REVALIDATE_SECRET=
